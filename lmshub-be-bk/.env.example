# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lmshub

# ── Redis (queue/cache — optional in development) ───────
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ──────────────────────────────────────────
# MUST BE CHANGED BEFORE PRODUCTION. Both values must be random, different from
# each other, and at least 32 characters long. The server REFUSES to start with
# NODE_ENV=production if either still holds a placeholder, is too short, or the
# two are identical.
#
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# (The web installation wizard fills both lines in for you automatically.)
JWT_ACCESS_SECRET=REPLACE-WITH-A-RANDOM-VALUE-OF-32-CHARACTERS-OR-MORE
JWT_REFRESH_SECRET=REPLACE-WITH-A-DIFFERENT-RANDOM-VALUE-OF-32-CHARACTERS-OR-MORE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Bootstrap super admin (seed) ────────────────────────
# Change both of these before running the seed on any server that is reachable
# from the internet. They are the credentials of the first administrator account.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-THIS-BEFORE-SEEDING
BOOTSTRAP_ADMIN_NAME=Super Admin

# ── Email / SMTP (fallback; the super admin sets the real values in Settings) ──
EMAIL_FROM=LMS Hub <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Google OAuth (the client id can also be set in Settings) ──
GOOGLE_CLIENT_ID=

# ── Payment gateways ────────────────────────────────────
# NOTHING NEEDS TO BE FILLED IN HERE. As of this version every gateway is
# configured from the admin panel: Settings → Payment Methods. There you tick the
# gateways you want active, paste their credentials, and copy the ready-made
# webhook URL — without touching this file or restarting the server.
#
# The variables below are still read as a FALLBACK, so existing installations
# that already filled them in keep working. When a value exists in Settings, that
# value wins.
#
# A gateway with no credentials does not appear at checkout. If ALL of them are
# empty, gateway checkout is refused with a clear message — the order stays
# unpaid and paid courses are not released. Selling without a gateway still works
# through manual bank transfer, which an administrator confirms.
#
# For local development only, the line below settles orders without calling any
# gateway so that the purchase flow can be exercised. NEVER enable it on a real
# server — the server refuses to start when NODE_ENV=production and this flag is
# on.
# PAYMENT_DEV_AUTOSETTLE=true
#
# Webhook URL pattern (register this in each gateway's own dashboard):
#   <APP_URL>/api/v1/orders/webhook/<gateway-name>
# for example: https://api.example.com/api/v1/orders/webhook/stripe

# Stripe — global (cards, Apple Pay, Google Pay). dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Developers → Webhooks after registering the endpoint. Starts with whsec_
STRIPE_WEBHOOK_SECRET=
# Events to subscribe to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired

# PayPal — global. developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal dashboard; used to verify every delivery.
PAYPAL_WEBHOOK_ID=
PAYPAL_IS_PRODUCTION=false
# Events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED

# Razorpay — India. dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Events: payment_link.paid, payment.captured, payment.failed

# Paystack — Nigeria, Ghana, South Africa, Kenya. dashboard.paystack.com
# Paystack signs webhooks with the secret key; there is no separate secret.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Events: charge.success, charge.failed

# Flutterwave — pan-African. app.flutterwave.com → Settings → API
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" that you choose yourself on Flutterwave's Webhooks page.
FLUTTERWAVE_WEBHOOK_HASH=
# Events: charge.completed

# Mollie — Europe (iDEAL, Bancontact, SEPA). my.mollie.com → Developers → API keys
# Mollie does not sign webhooks; the backend re-fetches the payment status from
# Mollie's API before settling an order, so no extra secret is needed.
MOLLIE_API_KEY=

# Midtrans — Indonesia. dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Where the buyer lands after paying or cancelling.
# Leave empty to use <PUBLIC_WEB_URL>/payment/return and /payment/cancel.
# These pages only display the result — an order is ALWAYS settled by webhook.
PAYMENT_RETURN_URL=
PAYMENT_CANCEL_URL=

# ── Media / File storage ────────────────────────────────
# Nothing to fill in. Every file — profile photos, logos, page images, course
# media — is written to the `uploads/` folder next to this application, and
# served at `<APP_URL>/uploads/...`.
#
# All you need to do is make sure that folder is writable by the account running
# the service, and INCLUDE IT IN YOUR BACKUPS — its contents are not in the
# database.
#
# Object storage (Amazon S3, Wasabi, Cloudflare R2, DigitalOcean Spaces) is not
# supported yet. An earlier version listed STORAGE_DRIVER and S3_* here even
# though no line of code read them; those variables were removed so that nobody
# fills them in and then waits for something that will never happen.
